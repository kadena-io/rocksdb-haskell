packages: .

-- -------------------------------------------------------------------------- --
-- Platform specific locations of external libraries

if os(darwin)
    if arch(aarch64)
        package *
            extra-include-dirs:
                /opt/homebrew/include
            extra-lib-dirs:
                /opt/homebrew/lib
    else
        package *
            extra-include-dirs:
                /opt/local/include
                /opt/homebrew/include
            extra-lib-dirs:
                /opt/local/lib
                /opt/homebrew/lib

